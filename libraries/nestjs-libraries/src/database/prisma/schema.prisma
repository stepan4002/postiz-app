// ============================================================================
// SOCIAL COMMAND CENTRE — Phase 12: Upload-Post Gateway
// ============================================================================

// Upload-Post gateway account configuration (one per Organization)
model UploadPostConfig {
  id              String       @id @default(uuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKey          String
  apiKeyEncrypted Boolean      @default(false)
  planType        String       @default("professional")
  maxProfiles     Int          @default(25)
  enabled         Boolean      @default(true)
  lastVerifiedAt  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// Maps a Company+Language combination to one Upload-Post profile
model UploadPostProfile {
  id               String             @id @default(uuid())
  companyId        String
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profileUsername  String             @unique
  languageCode     String
  languageName     String
  brandId          String?
  brand            Brand?             @relation(fields: [brandId], references: [id])
  platforms        String[]
  platformSettings Json               @default("{}")
  integrationId    String?            @unique
  integration      Integration?       @relation(fields: [integrationId], references: [id])
  enabled          Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  logs             UploadPostLog[]

  @@unique([companyId, languageCode])
  @@index([organizationId])
  @@index([companyId])
}

// Tracks each Upload-Post API call for auditing and status polling
model UploadPostLog {
  id              String            @id @default(uuid())
  profileId       String
  profile         UploadPostProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  postVariantId   String?
  endpoint        String
  requestPayload  Json
  responseCode    Int?
  responseBody    Json?
  requestId       String?
  jobId           String?
  status          String            @default("pending")
  errorMessage    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([profileId])
  @@index([requestId])
  @@index([status])
}

