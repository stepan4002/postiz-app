{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest", "multer"],
    "module": "commonjs",
    "target": "es2017",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/__tests__/**/*.spec.ts"],
  "exclude": ["node_modules", "dist"]
}
