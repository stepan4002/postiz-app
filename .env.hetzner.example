# =============================================================================
# Postiz Social Media Command Centre — Hetzner Production Environment
# =============================================================================
# Copy this file to .env and fill in your values BEFORE building:
#   cp .env.hetzner.example .env
#   nano .env  # edit values
#   docker compose -f docker-compose.hetzner.yaml up -d --build
# =============================================================================

# ─── REQUIRED: Change These ─────────────────────────────────────────────────

# Replace with your Hetzner server IP or domain (e.g., http://123.45.67.89:9001)
FRONTEND_URL="http://YOUR_SERVER_IP:9001"
NEXT_PUBLIC_BACKEND_URL="http://YOUR_SERVER_IP:9001/api"

# Security keys — generate unique values for production!
# Generate JWT_SECRET:    openssl rand -base64 32
# Generate ENCRYPTION_KEY: openssl rand -hex 32
JWT_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
ENCRYPTION_KEY="CHANGE_ME_generate_with_openssl_rand_hex_32"

# ─── Database & Cache (Docker-internal, no need to change) ──────────────────

DATABASE_URL="postgresql://postiz-user:postiz-password@postiz-postgres:5432/postiz-db-local"
REDIS_URL="redis://postiz-redis:6379"
BACKEND_INTERNAL_URL="http://localhost:3000"
TEMPORAL_ADDRESS="temporal:7233"

# ─── Application Settings ──────────────────────────────────────────────────

NODE_ENV=production
IS_GENERAL="true"
DISABLE_REGISTRATION=true
LOG_LEVEL=info
NX_ADD_PLUGINS=false
API_LIMIT=30
NOT_SECURED=true

# ─── Auth Bypass (Tailscale/VPN — no login required) ──────────────────────
# Auto-creates an admin user and skips login/signup entirely.
# Only use on private networks (Tailscale, WireGuard, etc.)
SKIP_AUTH=true
NEXT_PUBLIC_SKIP_AUTH=true

# ─── Storage (local filesystem — no external dependencies) ──────────────────

STORAGE_PROVIDER="local"
UPLOAD_DIRECTORY="/uploads"
NEXT_PUBLIC_UPLOAD_DIRECTORY="/uploads"

# ─── AyrShare Gateway (Social Media Publishing) ────────────────────────────

ENABLE_AYRSHARE_GATEWAY=true
ENABLE_UPLOADPOST_GATEWAY=false
ENABLE_NATIVE_PROVIDERS=true
AYRSHARE_API_URL=https://api.ayrshare.com/api
# Set this to your public URL for webhook callbacks:
AYRSHARE_WEBHOOK_BASE_URL="http://YOUR_SERVER_IP:9001/api/ayrshare/webhooks"

# ─── AI Service (OpenAI for content generation/translation) ────────────────

OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# ─── Social Media API Keys (fill in as needed) ─────────────────────────────

X_API_KEY=""
X_API_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""
META_APP_ID=""
META_APP_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""
SLACK_ID=""
SLACK_SECRET=""
SLACK_SIGNING_SECRET=""
MASTODON_URL="https://mastodon.social"
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""

# ─── Performance Tuning ────────────────────────────────────────────────────

TEMPORAL_MAX_CONCURRENT_JOBS=3

# ─── Optional: Email (for user activation) ─────────────────────────────────

# RESEND_API_KEY=""
# EMAIL_FROM_ADDRESS=""
# EMAIL_FROM_NAME=""

# ─── Optional: Payment ─────────────────────────────────────────────────────

FEE_AMOUNT=0.05
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_SIGNING_KEY=""
STRIPE_SIGNING_KEY_CONNECT=""
