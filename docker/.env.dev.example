# Docker dev environment credentials
# Copy this file to docker/.env.dev and fill in your values
# Usage: docker compose -f docker/docker-compose.dev.yaml --env-file docker/.env.dev up -d

# PostgreSQL
POSTGRES_USER=postiz-user
POSTGRES_PASSWORD=postiz-password
POSTGRES_DB=postiz-db-local

# Constructed DATABASE_URL for app services (points to localhost:5432 for local dev)
DATABASE_URL=postgresql://postiz-user:postiz-password@localhost:5432/postiz-db-local

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible local storage)
MINIO_ROOT_USER=postiz-minio-user
MINIO_ROOT_PASSWORD=postiz-minio-password

# S3 / MinIO connection for application (used with STORAGE_PROVIDER=s3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=postiz-uploads
S3_ACCESS_KEY=postiz-minio-user
S3_SECRET_KEY=postiz-minio-password
S3_REGION=us-east-1
